{
	"name": "utest",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		// The Makefile runs everything via `docker run -v $(CURDIR)/...`; with a
		// private daemon those paths resolve inside this container.
		// moby packages are not published for Debian trixie; use Docker CE.
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		}
	},
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "mkdocs serve"
		}
	},
	"postCreateCommand": "sh .devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"EditorConfig.EditorConfig"
			]
		}
	}
}
